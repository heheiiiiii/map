# Claude (없으면 mock 모드로 실행)
ANTHROPIC_API_KEY=
CHAT_PROVIDER=anthropic      # anthropic | mock

# TTS (GPT-SoVITS on Modal)
TTS_PROVIDER=gptsovits       # gptsovits | mock
TTS_URL=https://your-workspace--village-call-tts-web.modal.run
TTS_TOKEN=change-me

# 통화 토큰 서명용 비밀값 (긴 랜덤 문자열)
CALL_SECRET=change-me-to-a-long-random-string

PORT=3000

# 사용 제한
CALL_MAX_SECONDS=300
CALL_MAX_TURNS=30
IP_DAILY_CALLS=5
GLOBAL_DAILY_CALLS=300
MAX_UTTERANCE_CHARS=300
